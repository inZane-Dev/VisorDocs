<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      El fragment de androidx.pdf es una vista clásica de Android, no Compose, así
      que necesita un tema Material3 en la Activity. Compose aplica sus propios
      colores por encima (ver ui/theme/Theme.kt).
    -->
    <style name="Theme.VisorDocs" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
