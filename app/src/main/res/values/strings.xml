<?xml version="1.0" encoding="utf-8"?>
<!--
  Idioma por omision: ingles.

  Android elige la carpeta de recursos segun el idioma del telefono. Esta es la que usa
  cuando no hay una traduccion para ese idioma, asi que conviene que sea la de mayor
  alcance: un telefono en aleman o en japones vera ingles, no espanol.

  El espanol vive en values-es/strings.xml.
-->
<resources>
    <!-- El nombre propio de la app no se traduce. -->
    <string name="app_name" translatable="false">VisorDocs</string>

    <!-- Label shown in the system "Open with" menu. -->
    <string name="open_with_label">Open in VisorDocs</string>

    <!-- Home screen -->
    <string name="home_subtitle">Pick a document to view it, or open one straight from WhatsApp, Gmail or Files.</string>
    <string name="open_document">Open document</string>
    <string name="pdf_engine_label">PDF engine: %1$s</string>

    <!-- Viewer -->
    <string name="back">Back</string>
    <string name="loading">Loading…</string>
    <string name="loading_document">Opening the document…</string>
    <string name="page_number">Page %1$d</string>

    <!-- Shown when neither the provider nor the URI give the file a name. -->
    <string name="document_fallback_name">document</string>

    <!-- Format names. Shown under the title in the top bar. -->
    <!-- "PDF" se escribe igual en todos los idiomas. -->
    <string name="format_pdf" translatable="false">PDF</string>
    <string name="format_word">Word document</string>
    <string name="format_word_legacy">Word document (legacy format)</string>
    <string name="format_excel">Excel spreadsheet</string>
    <string name="format_excel_legacy">Excel spreadsheet (legacy format)</string>
    <string name="format_powerpoint">PowerPoint presentation</string>
    <string name="format_powerpoint_legacy">PowerPoint presentation (legacy format)</string>
    <string name="format_odt">LibreOffice document</string>
    <string name="format_ods">LibreOffice spreadsheet</string>
    <string name="format_odp">LibreOffice presentation</string>
    <string name="format_rtf">RTF document</string>
    <string name="format_epub">EPUB book</string>
    <string name="format_html">Web page</string>
    <string name="format_plain_text">Text file</string>
    <string name="format_csv">CSV file</string>
    <string name="format_image">Image</string>
    <string name="format_svg">SVG vector image</string>
    <string name="format_unknown">Unknown format</string>

    <!-- Text inserted inside the converted document. -->
    <string name="office_sheet">Sheet</string>
    <string name="office_slide">Slide</string>
    <string name="office_truncated">This document is very long: only the first part is shown.</string>
    <string name="office_empty">This document has no content to show.</string>
    <string name="empty_document_title">Empty document</string>

    <!-- Merging PDFs -->
    <string name="merge_add">Add another PDF</string>
    <string name="merge_save">Save the merged PDF</string>
    <string name="merge_discard_all">Clear</string>
    <string name="merge_remove_one">Remove from the merge</string>
    <string name="merge_move_up">Move up</string>
    <string name="merge_move_down">Move down</string>
    <string name="merge_open_document">Open document</string>
    <!-- Appended to the file name proposed when saving: "report-merged.pdf". -->
    <string name="merge_file_suffix">merged</string>
    <plurals name="merge_pending">
        <item quantity="one">%1$d document will be merged</item>
        <item quantity="other">%1$d documents will be merged</item>
    </plurals>
    <string name="merge_in_progress">Merging the documents…</string>
    <string name="merge_saved">PDF merged and saved</string>
    <string name="merge_failed">The documents could not be merged</string>

    <!-- Errors and formats -->
    <string name="error_open_title">The document could not be opened</string>
    <string name="error_open_body">The file may be damaged or incomplete. Try downloading it again.</string>
    <string name="error_password_title">Protected document</string>
    <string name="error_password_legacy_body">This PDF asks for a password, and the engine available on your device does not support passwords.</string>
    <string name="unsupported_format_title">%1$s: not available yet</string>
    <string name="unsupported_format_body">This is an old binary Office format. Open it once with Word, Excel or PowerPoint and save it as .docx, .xlsx or .pptx.</string>
    <string name="unknown_format_title">Unrecognised format</string>
    <string name="unknown_format_body">The file type could not be identified. Check that it is a valid document.</string>
</resources>
